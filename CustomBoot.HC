// CustomBoot.HC - Runs on startup
U0 CustomBoot()
{
    DocClear;
    
    Print("\n\n");
    Print("╔══════════════════════════════════════╗\n");
    Print("║         Welcome to ZenithOS          ║\n");
    Print("║           Custom Build by You        ║\n");
    Print("╚══════════════════════════════════════╝\n\n");
    
    Print("Type `RunFile(\"HelloBro.HC\");` anytime to say hello.\n\n");
    
    // You can add more stuff here (wallpaper, music, etc.)
}

CustomBoot;